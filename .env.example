# Copy this file to .env locally and fill only your private values there.
# Do not commit .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=btc_data

# Optional: override data locations when running the project from another disk.
PROJECT_DATA_DIR=
PROJECT_NEW_MARKET_DATA_DIR=
PROJECT_MARKET_CLEAN_DIR=
PROJECT_SOURCE_DATA_DIR=
FED_SOURCE_DIR=
EURO_SOURCE_DIR=

NEWSDATA_API_KEY=
CRYPTOPANIC_API_TOKEN=

# Keep SQL writes disabled by default during analysis/dashboard work.
DEFAULT_UPDATE_SQL=false
